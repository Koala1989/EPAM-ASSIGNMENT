# Copy to .env.<environment> (e.g. .env.local or .env.staging) in automation/config/; that file is gitignored.
# It is loaded for TEST_ENV=<environment>. Variables already set in the shell or CI win over the file.
# Select the environment when running tests:  $env:TEST_ENV='staging'; npm test   (PowerShell)

# Overrides of environments/<environment>.json (optional)
INVENTREE_URL=
TEST_TIMEOUT_MS=
EXPECT_TIMEOUT_MS=

# Test user passwords. Required for any environment without "demoPasswords": true.
INVENTREE_ADMIN_PASSWORD=
INVENTREE_ALLACCESS_PASSWORD=
INVENTREE_ENGINEER_PASSWORD=
INVENTREE_READER_PASSWORD=
INVENTREE_NOACCESS_PASSWORD=
INVENTREE_STEVEN_PASSWORD=
